# Resend API key. Get from https://resend.com/api-keys
# Use a key with "Sending access".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# FROM address for outbound email.
#
# PHASE 1 (no custom domain yet): must use the resend.dev sandbox.
#   While FROM is on resend.dev, Resend will ONLY deliver to the
#   email that owns your Resend account. Any other recipient is
#   rejected with a 403.
#   Example: Fork & Flower <onboarding@resend.dev>
#
# PHASE 2 (after verifying a custom domain/subdomain in Resend):
#   Use any address on that domain, e.g. hello@mail.yourdomain.com.
#   Client confirmation emails auto-enable when FROM_EMAIL no longer
#   contains "resend.dev".
FROM_EMAIL="Fork & Flower <onboarding@resend.dev>"

# Where inquiry notifications are delivered (the business owner's inbox).
# While FROM_EMAIL is on resend.dev, this MUST be the same email that
# owns the Resend account.
BUSINESS_EMAIL=owner@example.com

# Dev-only override: force-send the customer confirmation email even while
# FROM_EMAIL is on the resend.dev sandbox. Only works if you submit the form
# with an email that matches your Resend account owner — Resend will reject
# any other recipient. Leave unset (or remove) for production.
# FORCE_CLIENT_CONFIRMATION=true
