# Resend API key. Get from https://resend.com/api-keys
# Use a key with "Sending access".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# FROM address for outbound email.
#
# PHASE 1 (no custom domain yet): must use the resend.dev sandbox.
#   While FROM is on resend.dev, Resend will ONLY deliver to the
#   email that owns your Resend account. Any other recipient is
#   rejected with a 403.
#   Example: Fork & Flower <onboarding@resend.dev>
#
# PHASE 2 (after verifying a custom domain/subdomain in Resend):
#   Use any address on that domain, e.g. hello@mail.yourdomain.com.
#   Client confirmation emails auto-enable when FROM_EMAIL no longer
#   contains "resend.dev".
FROM_EMAIL="Fork & Flower <onboarding@resend.dev>"

# Where inquiry notifications are delivered (the business owner's inbox).
# While FROM_EMAIL is on resend.dev, this MUST be the same email that
# owns the Resend account.
BUSINESS_EMAIL=owner@example.com

# Dev-only override: force-send the customer confirmation email even while
# FROM_EMAIL is on the resend.dev sandbox. Only works if you submit the form
# with an email that matches your Resend account owner — Resend will reject
# any other recipient. Leave unset (or remove) for production.
# FORCE_CLIENT_CONFIRMATION=true

# Slack Incoming Webhook for inquiry notifications.
# Create one at https://api.slack.com/messaging/webhooks and paste the URL.
# Every submission triggers a Slack post with the full inquiry details —
# and a clearly-labeled failure alert if the owner notification email fails,
# so the lead is never lost. Leave unset to disable Slack (logged warning).
# Put the real URL only in .env.local. Example files must stay empty here — GitHub may block pushes that contain a full Slack webhook URL, even as a placeholder.
SLACK_WEBHOOK_URL=

# Dev-only: force the owner-notification email to fail so you can verify the
# Slack failure-alert path. Hard-gated on NODE_ENV !== "production" — even
# if this is accidentally set on Vercel Production, it is ignored.
# SIMULATE_OWNER_EMAIL_FAILURE=true

# Cloudflare Turnstile (bot protection on the inquiry form).
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# and paste the two keys below. The SITE key is exposed to the browser
# (safe — it is a public identifier). The SECRET key is server-only.
#
# Dev ergonomics: if TURNSTILE_SECRET_KEY is unset and NODE_ENV !=
# "production", server-side verification is skipped with a console.warn,
# so local dev does not require a live widget. In production, an unset
# secret makes every submission fail verification (fail-closed).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
